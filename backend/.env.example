# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string

# --- Infra ---
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# --- Scheduler tuning (nothing is hardcoded) ---
WORKER_CONCURRENCY=5
# Minimum gap between ANY two sends (BullMQ limiter) - mimics provider throttling
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Default per-sender hourly cap. A batch's own "Hourly Limit" may only LOWER it.
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# How many Ethereal sender accounts to create for each new user
SENDERS_PER_USER=2
# A "processing" email whose worker has been silent this long is treated as crashed and re-claimed
STALE_LOCK_MS=60000

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Slack OAuth (https://api.slack.com/apps) ---
# Scope: incoming-webhook. Redirect URL: <BACKEND_URL>/api/slack/callback (must be https for Slack; use ngrok in dev)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
