{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://outboxreachinbox-production.up.railway.app/api/:path*"
        },
        {
            "source": "/admin/:path*",
            "destination": "https://outboxreachinbox-production.up.railway.app/admin/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}